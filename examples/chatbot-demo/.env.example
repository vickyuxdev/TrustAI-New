# ─────────────────────────────────────────────────────────────
# TrustAI Chatbot Demo — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── TrustAI SDK (REQUIRED) ────────────────────────────────────
# Generate an API key in: Dashboard → Settings → API Keys
TRUSTAI_API_KEY=tai_live_your_project_key


# Copy your project UUID from: Dashboard → Projects
TRUSTAI_PROJECT_ID=your-project-uuid


# Runtime environment label (shows up in Dashboard filters)
TRUSTAI_ENV=development

# Where the TrustAI Ingestion Service is running
# Default: http://localhost:8001  (local Docker Compose stack)
TRUSTAI_INGEST_URL=http://localhost:8001

# Content capture mode:
#   full     → capture raw prompts + responses (visible in trace detail)
#   masked   → capture with PII auto-redacted  (recommended for dev)
#   disabled → no content captured at all
TRUSTAI_CAPTURE_MODE=masked

# ── OpenAI (OPTIONAL) ─────────────────────────────────────────
# Set USE_REAL_OPENAI=true to call real GPT instead of the
# built-in simulator. The simulator works with no API key.
USE_REAL_OPENAI=false
OPENAI_API_KEY=sk-your-key-here

# ── Azure OpenAI (used by chatbot.py) ────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Demo identity (OPTIONAL) ──────────────────────────────────
# User ID to tag all spans with (helpful for filtering in Dashboard)
DEMO_USER_ID=demo-dev-01

# ── Model pricing (OPTIONAL) ──────────────────────────────────
# Used by the SDK to compute cost_usd per LLM call locally.
# If not set, cost_usd will be null on spans.
# Server-side cost is also computed from the ModelPricing DB table.
AZURE_OPENAI_PRICE_INPUT_PER_1M=0.15
AZURE_OPENAI_PRICE_OUTPUT_PER_1M=0.60
AZURE_OPENAI_PRICE_CACHED_INPUT_PER_1M=0.075
