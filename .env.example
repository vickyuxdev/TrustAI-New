# ─────────────────────────────────────────────
# TrustAI — Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Databases ──────────────────────────────────────────────────
TRUSTAI_POSTGRES_URL=postgresql+asyncpg://trustai:trustai@localhost:5432/trustai
TRUSTAI_ANALYTICS_DB_URL=postgresql+asyncpg://trustai:trustai@localhost:5433/trustai_analytics
TRUSTAI_DB_POOL_SIZE=10
TRUSTAI_DB_MAX_OVERFLOW=20

# ── Redis ──────────────────────────────────────────────────────
TRUSTAI_REDIS_URL=redis://localhost:6379/0

# ── Azure AD / Entra ID SSO ────────────────────────────────────
# Register an App in Entra ID with:
#   - Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
#   - API permissions: openid, profile, email, offline_access
#   - Expose an API: api://trustai (for the backend audience)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-client-secret
TRUSTAI_API_SCOPE=api://trustai/.default
TRUSTAI_AZURE_AUDIENCE=api://trustai

# ── JWT (for internal service-to-service auth fallback) ────────
TRUSTAI_JWT_SECRET=generate-a-256bit-random-key-here

# ── Azure Event Hub ────────────────────────────────────────────
# Used for async span ingestion pipeline
AZURE_EVENTHUB_CONNECTION_STRING=Endpoint=sb://...
AZURE_EVENTHUB_NAME=trustai-telemetry
AZURE_EVENTHUB_CONSUMER_GROUP=$Default
AZURE_EVENTHUB_CHECKPOINT_URL=DefaultEndpointsProtocol=https;...

# ── Azure Application Insights ─────────────────────────────────
# The same App Insights that tracing_utils.py exports to
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
APPLICATIONINSIGHTS_INSTRUMENTATION_KEY=   # only for send_test_events.py
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
AZURE_LOG_ANALYTICS_WORKSPACE_KEY=your-workspace-key

# ── App General ────────────────────────────────────────────────
TRUSTAI_ENVIRONMENT=development
TRUSTAI_LOG_LEVEL=INFO
TRUSTAI_CORS_ORIGINS=["http://localhost:3000"]
TRUSTAI_INTERNAL_API_SECRET=change-me-for-production

# ── Dashboard (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_ADMIN_URL=http://localhost:8003
NEXT_PUBLIC_INGESTION_URL=http://localhost:8001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-32char-random-string

# ── Model Pricing (optional — SDK backward compat) ─────────────
# These are for the SDK's local cost fallback (tracing_utils.py compat)
# Server-side cost is computed from the ModelPricing DB table instead
AZURE_OPENAI_PRICE_INPUT_PER_1M=2.50
AZURE_OPENAI_PRICE_OUTPUT_PER_1M=10.00
AZURE_OPENAI_PRICE_CACHED_INPUT_PER_1M=1.25

# ── Governance service (:8004) ─────────────────────────────────
# Evaluations: inline (single process) or redis (governance-worker container)
TRUSTAI_EVAL_EXECUTOR=redis
TRUSTAI_PORTAL_URL=http://localhost:3000
TRUSTAI_GATEWAY_PUBLIC_URL=http://localhost:8005
TRUSTAI_GATEWAY_DEFAULT_MODEL=gpt-4o
# Comma list of models the gateway serves (empty = default model + each agent's model)
TRUSTAI_GATEWAY_MODELS=gpt-4o,gpt-4o-mini
# Optional scoring backends (built-in detectors always run)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# LLM judge for adherence + red-team grading: none | openai | azure_openai
TRUSTAI_JUDGE_PROVIDER=none
TRUSTAI_JUDGE_BASE_URL=
TRUSTAI_JUDGE_API_KEY=
TRUSTAI_JUDGE_MODEL=gpt-4o-mini

# ── AI Gateway (:8005) ─────────────────────────────────────────
# Model routes live in services/gateway/upstreams.example.yaml (keys referenced by env var name)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: send gateway calls to TrustAI traces (a project API key with the "ingest" scope)
TRUSTAI_GATEWAY_INGEST_API_KEY=
TRUSTAI_GATEWAY_INGEST_PROJECT_ID=
NEXT_PUBLIC_GOVERNANCE_URL=http://localhost:8004

# Single-file HTTPS stack: docker-compose.traefik.yml (Compose >= 2.23.1).
# Confirm DNS spelling before deployment.
# Confirmed public hostname; DNS and certificate must cover this name.
TRUSTAI_PUBLIC_HOST=trustai.rtdomain.in
TRUSTAI_TLS_CERTS_DIR=/home/azureuser/traefik
# Choose an approved fixed Traefik v3 tag/digest before production use.
TRUSTAI_TRAEFIK_IMAGE=traefik:v3
# Where AI Factory's deploy_vm.py writes one route file per deployed agent (agent-<slug>.yml). Must match
# AZURE_VM_ROUTES_DIR on the AI-Factory-V2 side exactly - leave both at the default and they already agree.
AI_FACTORY_ROUTES_DIR=/opt/ai-factory/proxy/dynamic
